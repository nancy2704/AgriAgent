# ============================================================
# AgriAgent — Environment Configuration
# Copy this file to .env and fill in your credentials.
# Never commit .env to version control.
# ============================================================

# -----------------------------------------------------------
# OpenAI API Key (required for AI-generated action plans)
# Obtain from: https://platform.openai.com/api-keys
# If not set, AgriAgent runs in demo mode with template plans.
# -----------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here

# -----------------------------------------------------------
# OpenWeatherMap API Key (required for live weather data)
# Obtain from: https://openweathermap.org/api (free tier available)
# If not set, AgriAgent shows clearly labelled demo weather data.
# -----------------------------------------------------------
OPENWEATHER_API_KEY=your_openweather_api_key_here

# -----------------------------------------------------------
# Database path (optional — defaults to agriagent.db in project root)
# -----------------------------------------------------------
# AGRIAGENT_DB_PATH=agriagent.db
